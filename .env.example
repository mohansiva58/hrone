MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?appName=<app-name>
MONGO_DB=attendance_db

# Destructive integration tests require explicit opt-in. Set these in the shell,
# not here, so running pytest from a copied example cannot modify remote data.
# ALLOW_ATLAS_TESTS=1
# TEST_MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/?appName=<app-name>
# TEST_MONGO_DB=test_attendance_db
